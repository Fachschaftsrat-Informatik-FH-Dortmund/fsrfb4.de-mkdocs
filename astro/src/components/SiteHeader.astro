---
import ThemeToggle from "./ThemeToggle.astro";

const { pathname } = Astro.url;

const navItems = [
  { href: "/", label: "Home" },
  { href: "/erstis/", label: "Erstis" },
  { href: "/ekeys/", label: "E-Keys" },
  { href: "/app/", label: "FSR-App" },
  { href: "/aktuelles/", label: "Aktuelles" },
  { href: "/kontakt/", label: "Kontakt" },
  { href: "/impressum/", label: "Impressum" },
];

const isCurrent = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="site-header">
  <a class="site-header__brand" href="/">FSR Informatik</a>
  <nav class="site-header__nav" aria-label="Hauptnavigation">
    <ul>
      {
        navItems.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <ThemeToggle />
</header>

<style lang="scss">
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--fsr-space-md);
    padding: var(--fsr-space-md) var(--fsr-space-lg);
    background: var(--fsr-color-header-bg);
    // In the dark theme the bar and the page are close enough in tone that the
    // header would otherwise have no visible edge.
    border-bottom: 1px solid var(--fsr-color-border);

    &__brand {
      font-weight: 700;
      font-size: 1.1rem;
      color: var(--fsr-color-header-fg);
      text-decoration: none;
    }

    &__nav {
      margin-right: auto;
    }

    &__nav ul {
      display: flex;
      flex-wrap: wrap;
      gap: var(--fsr-space-md);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    &__nav a {
      color: var(--fsr-color-header-fg);
      text-decoration: none;
      text-transform: uppercase;
      font-size: 0.85rem;
      letter-spacing: 0.04em;
      border-bottom: 2px solid transparent;

      &:hover,
      &[aria-current="page"] {
        border-bottom-color: var(--fsr-color-accent);
      }
    }
  }
</style>
